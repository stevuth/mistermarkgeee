
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Core Philosophy: This ruleset implements a Role-Based Access Control (RBAC) model.
     * A dedicated '/roles_admin' collection explicitly defines which users are
     * administrators. All write access to public content, such as blog posts, is
     * restricted to these designated admins. Public content is readable by anyone,
     * including unauthenticated users, to support a public-facing website.
     *
     * Data Structure:
     * - /blogPosts/{blogPostId}: A top-level collection containing all public blog posts.
     * - /roles_admin/{userId}: A top-level collection used as an access control list. The
     *   existence of a document with a user's UID as its ID grants them admin privileges.
     *
     * Key Security Decisions:
     * - Admin Role Management: The '/roles_admin' collection is read-only from the client side.
     *   Adding or removing admins MUST be done through a trusted server environment using
     *   the Firebase Admin SDK. This prevents any user from escalating their own privileges.
     * - Public Read Access: The '/blogPosts' collection is publicly readable to allow the
     *   website to display articles to all visitors.
     * - Admin-Only Writes: All create, update, and delete operations on '/blogPosts' are
     *   strictly limited to users who are authenticated and identified as admins.
     * - No User Enumeration: Listing documents in the '/roles_admin' collection is explicitly
     *   forbidden to prevent attackers from discovering who the administrators are.
     */

    // --------------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function incomingData() {
      return request.resource.data;
    }


    // --------------------------------------------------------------------------
    // Collection Rules
    // --------------------------------------------------------------------------

    match /blogPosts/{blogPostId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin() && incomingData().id == blogPostId;
      allow update: if isAdmin() && resource != null && incomingData().id == resource.data.id;
      allow delete: if isAdmin() && resource != null;
    }

    match /roles_admin/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      // Bootstrapping rule: allow the specific admin email to create their own role document
      allow create: if isOwner(userId) && request.auth.token.email == "mark.gaturuku@gmail.com";
      allow update: if false;
      allow delete: if false;
    }
  }
}
